apiVersion: source.toolkit.fluxcd.io/v1beta2
kind: HelmRepository
metadata:
  name: grafana
  namespace: flux-system
spec:
  interval: 1m
  url: https://grafana.github.io/helm-charts
---
apiVersion: helm.toolkit.fluxcd.io/v2beta2
kind: HelmRelease
metadata:
  name: loki
  namespace: flux-system
spec:
  interval: 1m
  targetNamespace: monitoring
  chart:
    spec:
      chart: loki
      version: ${LOKI_CHART_VERSION}
      sourceRef:
        kind: HelmRepository
        name: grafana
        namespace: flux-system
      interval: 1m
  install:
    remediation:
      retries: 3
  upgrade:
    remediation:
      retries: 3
  values:
    # Global configuration for environment variables
    global:
      extraArgs:
        - '-config.expand-env=true'
        - '-log.level=info'
      extraEnv:
        - name: REDIS_PASSWORD
          valueFrom:
            secretKeyRef:
              name: redis-password
              key: password
    
    # Loki configuration
    loki:
      # Authentication
      auth_enabled: false
      
      # Common configuration
      commonConfig:
        path_prefix: /var/loki
        # Critical HA: Increase replication factor for data redundancy
        # Ensures data is replicated across multiple ingesters
        replication_factor: 2
        # Update compactor address for distributed mode
        compactor_address: 'loki-backend'
      
      # Schema configuration
      schemaConfig:
        configs:
          - from: "2024-04-01"
            store: tsdb
            object_store: filesystem
            schema: v13
            index:
              prefix: loki_index_
              period: 24h
      
      # Storage configuration  
      storage:
        type: 'filesystem'
        filesystem:
          chunks_directory: /var/loki/chunks
          rules_directory: /var/loki/rules
      
      # Use structuredConfig to properly override all cache configurations
      structuredConfig:
        # Pattern ingester configuration for log pattern recognition
        # Enables automatic pattern detection and extraction from log streams
        pattern_ingester:
          enabled: true
        
        # Ingester configuration for data safety
        # Ensures WAL is flushed before ingester shutdown for data consistency
        ingester:
          chunk_encoding: snappy
          wal:
            flush_on_shutdown: true
        
        # Querier configuration for performance
        # Limits concurrent queries per querier to prevent resource exhaustion
        querier:
          max_concurrent: 4
        
        # Schema configuration for filesystem storage (SingleBinary mode)
        schemaConfig:
          configs:
          - from: "2024-04-01"
            store: tsdb
            object_store: filesystem
            schema: v13
            index:
              prefix: loki_index_
              period: 24h
        
        # Storage configuration for SingleBinary mode
        storage_config:
          tsdb_shipper:
            active_index_directory: /var/loki/tsdb-index
            cache_location: /var/loki/tsdb-cache
          filesystem:
            directory: /var/loki/chunks
        
        # Limits configuration
        limits_config:
          retention_period: ${LOKI_RETENTION_PERIOD}
          reject_old_samples: true
          reject_old_samples_max_age: 168h
          max_cache_freshness_per_query: 10m
          split_queries_by_interval: 15m
          per_stream_rate_limit: 512M
          per_stream_rate_limit_burst: 1024M
          ingestion_rate_mb: 512
          ingestion_burst_size_mb: 1024
          max_streams_per_user: 10000
          max_line_size: 256000
          allow_structured_metadata: true
          volume_enabled: true
        
        # Ruler configuration for alerting
        ruler:
          enable_api: true
          storage:
            type: local
            local:
              directory: /var/loki/rules
          rule_path: /var/loki/rules-temp
        
        # Query range configuration with caching
        query_range:
          align_queries_with_step: true
          cache_results: true
          results_cache:
            cache:
              redis:
                # Read-heavy cache can use load-balanced service for performance
                endpoint: redis.redis.svc.cluster.local:6379
                password: "$${REDIS_PASSWORD}"
                db: 0
                expiration: ${LOKI_CACHE_EXPIRATION}
                timeout: ${LOKI_CACHE_TIMEOUT}
                pool_size: ${LOKI_REDIS_POOL_SIZE}
                idle_timeout: 90s
                max_connection_age: 10m
        
        # Frontend configuration with caching
        frontend:
          address: 0.0.0.0
          compress_responses: true
        
        # Chunk store configuration with Redis cache
        chunk_store_config:
          chunk_cache_config:
            redis:
              # Read-heavy chunk metadata cache can use load-balanced service
              endpoint: redis.redis.svc.cluster.local:6379
              password: "$${REDIS_PASSWORD}"
              db: 1
              expiration: ${LOKI_CACHE_EXPIRATION}
              timeout: ${LOKI_CACHE_TIMEOUT}
              pool_size: ${LOKI_REDIS_POOL_SIZE}
              idle_timeout: 90s
              max_connection_age: 10m
          write_dedupe_cache_config:
            redis:
              # CRITICAL: Write deduplication MUST go to master for data consistency
              endpoint: redis-master.redis.svc.cluster.local:6379
              password: "$${REDIS_PASSWORD}"
              db: 2
              expiration: 10m
              timeout: 500ms
              pool_size: ${LOKI_WRITE_POOL_SIZE}
              idle_timeout: 90s
              max_connection_age: 10m
        
        # Storage configuration for SimpleScalable mode (requires object storage)
        # Uses LocalStack S3 for scalable deployment
        storage_config:
          aws:
            s3: s3://test:test@localstack.localstack.svc.cluster.local:4566/loki-chunks
            s3forcepathstyle: true
          tsdb_shipper:
            active_index_directory: /var/loki/tsdb-index
            cache_location: /var/loki/tsdb-cache
          index_queries_cache_config:
            redis:
              # Read-heavy index cache can use load-balanced service for performance
              endpoint: redis.redis.svc.cluster.local:6379
              password: "$${REDIS_PASSWORD}"
              db: 3
              expiration: ${LOKI_CACHE_EXPIRATION}
              timeout: ${LOKI_CACHE_TIMEOUT}
              pool_size: ${LOKI_REDIS_POOL_SIZE}
              idle_timeout: 90s
              max_connection_age: 10m
    
    # Storage configuration for Helm chart level (required for SimpleScalable validation)
    # Object storage is mandatory for SimpleScalable deployment mode
    objectStorage:
      enabled: true
    storage:
      type: s3
      bucketNames:
        chunks: loki-chunks
        ruler: loki-ruler  
        admin: loki-admin
      s3:
        endpoint: localstack.localstack.svc.cluster.local:4566
        region: us-east-1
        accessKeyId: test
        secretAccessKey: test
        s3ForcePathStyle: true
        insecure: true
    
    # Disable MinIO (using LocalStack S3 instead)
    minio:
      enabled: false
    
    # Deployment mode - Single Binary for simplicity in local dev
    # TODO: Migrate to SimpleScalable for production with proper object storage
    deploymentMode: SingleBinary
    
    # SingleBinary configuration
    singleBinary:
      replicas: 1
      persistence:
        enabled: true
        storageClass: "standard"
        size: ${LOKI_STORAGE_SIZE}
      resources:
        limits:
          cpu: "1000m"
          memory: "2Gi"
        requests:
          cpu: "500m"
          memory: "1Gi"
    
    # Gateway configuration - entry point for all Loki requests
    gateway:
      enabled: true
      replicas: 2
      
      # Service configuration for external access
      service:
        type: ClusterIP  # Using ClusterIP for internal access, can be changed to LoadBalancer for external
      
      # High Availability: Pod Anti-Affinity
      affinity:
        podAntiAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
          - weight: 100
            podAffinityTerm:
              labelSelector:
                matchLabels:
                  app.kubernetes.io/name: loki
                  app.kubernetes.io/component: gateway
              topologyKey: kubernetes.io/hostname
    
    # SimpleScalable components configuration for high availability
    # Based on official Grafana Loki documentation for SimpleScalable mode
    
    # Write path components (handle log ingestion)
    write:
      replicas: 3
      # Conservative maxUnavailable for write path to ensure data durability
      # With replication_factor: 2, we need at least 2 healthy write replicas
      maxUnavailable: 1
      persistence:
        enabled: true
        storageClass: "standard"
        size: ${LOKI_STORAGE_SIZE}
      
      # High Availability: Hard Pod Anti-Affinity for critical write path
      # Ensures no two write pods can be scheduled on the same node
      affinity:
        podAntiAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
          - labelSelector:
              matchLabels:
                app.kubernetes.io/name: loki
                app.kubernetes.io/component: write
            topologyKey: kubernetes.io/hostname
    
    # Read path components (handle log queries)
    read:
      replicas: 3
      # Allow up to 1 replica to be unavailable during rolling updates
      # Maintains query capability with 2/3 replicas available
      maxUnavailable: 1
      
      # High Availability: Pod Anti-Affinity
      affinity:
        podAntiAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
          - weight: 100
            podAffinityTerm:
              labelSelector:
                matchLabels:
                  app.kubernetes.io/name: loki
                  app.kubernetes.io/component: read
              topologyKey: kubernetes.io/hostname
    
    # Backend components (compaction, indexing)
    backend:
      replicas: 2
      persistence:
        enabled: true
        storageClass: "standard"
        size: ${LOKI_STORAGE_SIZE}
      
      # High Availability: Pod Anti-Affinity
      affinity:
        podAntiAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
          - weight: 100
            podAffinityTerm:
              labelSelector:
                matchLabels:
                  app.kubernetes.io/name: loki
                  app.kubernetes.io/component: backend
              topologyKey: kubernetes.io/hostname
    
    # Disable unused microservice components (using simplified 3-component architecture)
    ingester:
      replicas: 0
    querier:
      replicas: 0
    queryFrontend:
      replicas: 0
    queryScheduler:
      replicas: 0
    distributor:
      replicas: 0
    compactor:
      replicas: 0
    indexGateway:
      replicas: 0
    bloomCompactor:
      replicas: 0
    bloomGateway:
      replicas: 0
    
    # Monitoring configuration
    monitoring:
      serviceMonitor:
        enabled: true
        namespace: monitoring
        interval: 30s
    
    # Test configuration
    test:
      enabled: false
    
    # Lokicanary (health check) configuration  
    lokiCanary:
      enabled: false
    
    # Gateway is already configured above in the main gateway section
    
    # Disable cache components for dev environment
    resultsCache:
      enabled: false
    chunksCache:
      enabled: false
    
    # Disable memcached components
    memcached:
      enabled: false
    memcachedExporter:
      enabled: false
    memcachedChunks:
      enabled: false
    memcachedFrontend:
      enabled: false
    memcachedIndexQueries:
      enabled: false