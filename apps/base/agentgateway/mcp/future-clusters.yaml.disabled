---
# FUTURE CLUSTER ONBOARDING — AgentgatewayBackend placeholder definitions.
#
# This file consolidates all placeholder backends for clusters not yet onboarded.
# To activate a cluster pair (k8s + helm backends):
#   1. Uncomment the relevant AgentgatewayBackend resources below.
#   2. Update host: to the remote cluster's kagent-tools Service DNS or ExternalName Service.
#   3. Add the pair to mcp/kustomization.yaml resources list.
#   4. Add corresponding /mcp/k8s/<cluster> and /mcp/helm/<cluster> rules to mcp/route.yaml.
#   5. Create a cluster-agent overlay in apps/base/kagent/agents/cluster-agent/<cluster>/.
#   6. Add the cluster-agent to coordinator-agent.yaml tools list.
#   See apps/base/kagent/agents/cluster-agent/README.md for the full onboarding procedure.
#
# THIS FILE IS NOT REFERENCED BY mcp/kustomization.yaml.
# Only active backends (backend-k8s-services-amer.yaml, backend-helm-services-amer.yaml) are applied.

# ============================================================
# platform-amer
# ============================================================

# ---
# apiVersion: agentgateway.dev/v1alpha1
# kind: AgentgatewayBackend
# metadata:
#   name: k8s-mcp-platform-amer
#   namespace: agentgateway-system
#   labels:
#     cluster: platform-amer
#     domain: k8s
# spec:
#   mcp:
#     targets:
#       - name: k8s-tools-platform-amer
#         static:
#           host: kagent-tools.kagent.svc.cluster.local  # Update for remote cluster
#           port: 8084
#           protocol: StreamableHTTP

# ---
# apiVersion: agentgateway.dev/v1alpha1
# kind: AgentgatewayBackend
# metadata:
#   name: helm-mcp-platform-amer
#   namespace: agentgateway-system
#   labels:
#     cluster: platform-amer
#     domain: helm
# spec:
#   mcp:
#     targets:
#       - name: helm-tools-platform-amer
#         static:
#           host: kagent-tools.kagent.svc.cluster.local  # Update for remote cluster
#           port: 8084
#           protocol: StreamableHTTP

