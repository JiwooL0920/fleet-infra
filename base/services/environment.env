# --- BASE CONFIGURATION ---
# These are the default values that can be overridden by specific environments

# Default cluster configuration
CLUSTER_NAME=base-cluster
ENVIRONMENT=base
REGION=us-east-1

# AWS Configuration
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# Crossplane AWS Provider Configuration
# These will be overridden per environment (dev uses LocalStack, prod uses real AWS)
AWS_ENDPOINT_URL=""
SKIP_CREDENTIALS_VALIDATION=false
SKIP_REQUESTING_ACCOUNT_ID=false
S3_USE_PATH_STYLE=false

# ========================================
# APPLICATION CONFIGURATIONS
# ========================================

# --- INFRASTRUCTURE CORE ---

# Traefik Ingress Controller
TRAEFIK_CHART_VERSION=32.1.1
TRAEFIK_MEMORY_REQUEST=128Mi
TRAEFIK_MEMORY_LIMIT=512Mi
TRAEFIK_CPU_REQUEST=100m
TRAEFIK_CPU_LIMIT=1000m
TRAEFIK_REPLICA_COUNT=1

# LocalStack (AWS Services Emulation)
LOCALSTACK_CHART_VERSION=0.6.15
LOCALSTACK_MEMORY_REQUEST=512Mi
LOCALSTACK_MEMORY_LIMIT=1Gi
LOCALSTACK_CPU_REQUEST=250m
LOCALSTACK_CPU_LIMIT=1000m
LOCALSTACK_STORAGE_SIZE=5Gi

# --- OPERATORS ---

# CNPG Operator (CloudNative PostgreSQL)
CNPG_OPERATOR_CHART_VERSION=0.24.0
CNPG_OPERATOR_MEMORY_REQUEST=128Mi
CNPG_OPERATOR_MEMORY_LIMIT=256Mi
CNPG_OPERATOR_CPU_REQUEST=100m
CNPG_OPERATOR_CPU_LIMIT=500m

# External Secrets Operator
EXTERNAL_SECRETS_CHART_VERSION=0.10.7
EXTERNAL_SECRETS_MEMORY_REQUEST=128Mi
EXTERNAL_SECRETS_MEMORY_LIMIT=256Mi
EXTERNAL_SECRETS_CPU_REQUEST=50m
EXTERNAL_SECRETS_CPU_LIMIT=200m
EXTERNAL_SECRETS_WEBHOOK_REPLICA_COUNT=1

# --- DATABASE SERVICES ---

# Redis (Cache and Session Store)
REDIS_CHART_VERSION=20.7.0
REDIS_REPLICA_COUNT=2
REDIS_MASTER_MEMORY_REQUEST=256Mi
REDIS_MASTER_MEMORY_LIMIT=512Mi
REDIS_MASTER_CPU_REQUEST=100m
REDIS_MASTER_CPU_LIMIT=500m
REDIS_REPLICA_MEMORY_REQUEST=256Mi
REDIS_REPLICA_MEMORY_LIMIT=512Mi
REDIS_REPLICA_CPU_REQUEST=100m
REDIS_REPLICA_CPU_LIMIT=500m
REDIS_STORAGE_SIZE=8Gi
REDIS_SENTINEL_TIMEOUT=30000
REDIS_FAILOVER_TIMEOUT=180000
REDIS_PARALLEL_SYNCS=1

# PostgreSQL (Primary Database)
POSTGRESQL_INSTANCES=1
POSTGRESQL_STORAGE_SIZE=20Gi
POSTGRESQL_MEMORY_REQUEST=1Gi
POSTGRESQL_MEMORY_LIMIT=2Gi
POSTGRESQL_CPU_REQUEST=500m
POSTGRESQL_CPU_LIMIT=2000m
POSTGRESQL_MAX_CONNECTIONS=200
POSTGRESQL_SHARED_BUFFERS=256MB
POSTGRESQL_EFFECTIVE_CACHE_SIZE=1GB
POSTGRESQL_BACKUP_RETENTION=30

# --- MONITORING STACK ---

# Loki (Log Aggregation)
LOKI_CHART_VERSION=6.23.1
LOKI_REPLICA_COUNT=1
LOKI_MEMORY_REQUEST=512Mi
LOKI_MEMORY_LIMIT=1Gi
LOKI_CPU_REQUEST=250m
LOKI_CPU_LIMIT=500m
LOKI_STORAGE_SIZE=10Gi
LOKI_RETENTION_PERIOD=720h
LOKI_CACHE_TIMEOUT=500ms
LOKI_CACHE_EXPIRATION=1h
LOKI_REDIS_POOL_SIZE=10
LOKI_WRITE_POOL_SIZE=5

# Prometheus Stack (Metrics and Monitoring)
PROMETHEUS_CHART_VERSION=65.8.1
PROMETHEUS_MEMORY_REQUEST=1Gi
PROMETHEUS_MEMORY_LIMIT=2Gi
PROMETHEUS_CPU_REQUEST=500m
PROMETHEUS_CPU_LIMIT=2000m
PROMETHEUS_STORAGE_SIZE=50Gi
PROMETHEUS_RETENTION_SIZE=10GiB
PROMETHEUS_RETENTION_TIME=30d
GRAFANA_MEMORY_REQUEST=256Mi
GRAFANA_MEMORY_LIMIT=512Mi
GRAFANA_CPU_REQUEST=100m
GRAFANA_CPU_LIMIT=500m
ALERTMANAGER_MEMORY_REQUEST=128Mi
ALERTMANAGER_MEMORY_LIMIT=256Mi

# Promtail (Log Shipping)
PROMTAIL_CHART_VERSION=6.23.1
PROMTAIL_MEMORY_REQUEST=128Mi
PROMTAIL_MEMORY_LIMIT=256Mi
PROMTAIL_CPU_REQUEST=50m
PROMTAIL_CPU_LIMIT=200m

# Metrics Server
METRICS_SERVER_CHART_VERSION=3.12.2
METRICS_SERVER_MEMORY_REQUEST=64Mi
METRICS_SERVER_MEMORY_LIMIT=128Mi
METRICS_SERVER_CPU_REQUEST=50m
METRICS_SERVER_CPU_LIMIT=200m

# --- APPLICATION SERVICES ---

# N8N (Workflow Automation)
N8N_CHART_VERSION=2.31.0
N8N_MEMORY_REQUEST=512Mi
N8N_MEMORY_LIMIT=1Gi
N8N_CPU_REQUEST=250m
N8N_CPU_LIMIT=1000m
N8N_STORAGE_SIZE=5Gi
N8N_DB_NAME=n8n
N8N_REPLICA_COUNT=1

# Temporal (Workflow Orchestration)
TEMPORAL_CHART_VERSION=0.51.0
TEMPORAL_SERVER_MEMORY_REQUEST=1Gi
TEMPORAL_SERVER_MEMORY_LIMIT=2Gi
TEMPORAL_SERVER_CPU_REQUEST=500m
TEMPORAL_SERVER_CPU_LIMIT=2000m
TEMPORAL_WEB_MEMORY_REQUEST=256Mi
TEMPORAL_WEB_MEMORY_LIMIT=512Mi
TEMPORAL_WEB_CPU_REQUEST=100m
TEMPORAL_WEB_CPU_LIMIT=500m
TEMPORAL_STORAGE_SIZE=10Gi
TEMPORAL_DB_NAME=temporal
TEMPORAL_VISIBILITY_DB_NAME=temporal_visibility

# --- DATABASE UI TOOLS ---

# pgAdmin4 (PostgreSQL Web UI)
PGADMIN4_CHART_VERSION=1.30.0
PGADMIN4_MEMORY_REQUEST=256Mi
PGADMIN4_MEMORY_LIMIT=512Mi
PGADMIN4_CPU_REQUEST=100m
PGADMIN4_CPU_LIMIT=500m
PGADMIN4_STORAGE_SIZE=2Gi

# RedisInsight (Redis Web UI)
REDISINSIGHT_MEMORY_REQUEST=128Mi
REDISINSIGHT_MEMORY_LIMIT=256Mi
REDISINSIGHT_CPU_REQUEST=50m
REDISINSIGHT_CPU_LIMIT=200m
REDISINSIGHT_STORAGE_SIZE=1Gi

# --- GITOPS AND MANAGEMENT ---

# Weave GitOps (GitOps Dashboard)
WEAVE_GITOPS_CHART_VERSION=4.0.36
WEAVE_GITOPS_MEMORY_REQUEST=128Mi
WEAVE_GITOPS_MEMORY_LIMIT=256Mi
WEAVE_GITOPS_CPU_REQUEST=50m
WEAVE_GITOPS_CPU_LIMIT=200m

# --- CROSSPLANE (Infrastructure as Code) ---

# Crossplane Core
CROSSPLANE_CHART_VERSION=1.19.0
CROSSPLANE_MEMORY_REQUEST=256Mi
CROSSPLANE_MEMORY_LIMIT=512Mi
CROSSPLANE_CPU_REQUEST=100m
CROSSPLANE_CPU_LIMIT=500m

# Crossplane AWS Provider
CROSSPLANE_AWS_PROVIDER_VERSION=v1.19.0

# --- PERFORMANCE AND TUNING ---

# Default resource requests and limits
DEFAULT_MEMORY_REQUEST=128Mi
DEFAULT_MEMORY_LIMIT=256Mi
DEFAULT_CPU_REQUEST=50m
DEFAULT_CPU_LIMIT=200m

# Storage classes and sizes
DEFAULT_STORAGE_CLASS=standard
DEFAULT_STORAGE_SIZE=5Gi

# Network and timeout settings
DEFAULT_CONNECTION_TIMEOUT=30s
DEFAULT_READ_TIMEOUT=60s
DEFAULT_WRITE_TIMEOUT=60s
