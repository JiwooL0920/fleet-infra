# ========================================
# DEVELOPMENT ENVIRONMENT OVERRIDES
# ========================================
# Cost-optimized configuration for development environment
# Lower resource allocations, reduced replicas, shorter retention periods

# Environment identification
CLUSTER_NAME=services-amer-dev
ENVIRONMENT=development

# --- INFRASTRUCTURE CORE (Dev Optimizations) ---

# Traefik - Single instance for development
TRAEFIK_MEMORY_REQUEST=256Mi
TRAEFIK_MEMORY_LIMIT=256Mi
TRAEFIK_CPU_REQUEST=500m
TRAEFIK_CPU_LIMIT=500m
TRAEFIK_REPLICA_COUNT=1

# LocalStack - Reduced resources for development
LOCALSTACK_MEMORY_REQUEST=512Mi
LOCALSTACK_MEMORY_LIMIT=512Mi
LOCALSTACK_CPU_REQUEST=500m
LOCALSTACK_CPU_LIMIT=500m
LOCALSTACK_STORAGE_SIZE=2Gi

# --- OPERATORS (Dev Optimizations) ---

# CNPG Operator - Minimal resources
CNPG_OPERATOR_MEMORY_REQUEST=128Mi
CNPG_OPERATOR_MEMORY_LIMIT=128Mi
CNPG_OPERATOR_CPU_REQUEST=200m
CNPG_OPERATOR_CPU_LIMIT=200m

# External Secrets - Minimal resources
EXTERNAL_SECRETS_MEMORY_REQUEST=128Mi
EXTERNAL_SECRETS_MEMORY_LIMIT=128Mi
EXTERNAL_SECRETS_CPU_REQUEST=100m
EXTERNAL_SECRETS_CPU_LIMIT=100m
EXTERNAL_SECRETS_WEBHOOK_REPLICA_COUNT=1

# --- DATABASE SERVICES (Dev Optimizations) ---

# Redis - Single replica for development
REDIS_REPLICA_COUNT=1
REDIS_MASTER_MEMORY_REQUEST=2Gi
REDIS_MASTER_MEMORY_LIMIT=2Gi
REDIS_MASTER_CPU_REQUEST=250m
REDIS_MASTER_CPU_LIMIT=250m
REDIS_REPLICA_MEMORY_REQUEST=2Gi
REDIS_REPLICA_MEMORY_LIMIT=2Gi
REDIS_REPLICA_CPU_REQUEST=250m
REDIS_REPLICA_CPU_LIMIT=250m
REDIS_STORAGE_SIZE=8Gi
REDIS_MAXMEMORY=1800mb
REDIS_SENTINEL_DOWN_AFTER_MILLISECONDS=30000
REDIS_SENTINEL_FAILOVER_TIMEOUT=180000
REDIS_SENTINEL_PARALLEL_SYNCS=1
REDIS_SENTINEL_MEM_REQ=64Mi
REDIS_SENTINEL_MEM_LIM=128Mi
REDIS_SENTINEL_CPU_REQ=50m
REDIS_SENTINEL_CPU_LIM=200m
REDIS_METRICS_ENABLED=false

# PostgreSQL - Single instance, smaller storage
POSTGRESQL_INSTANCES=1
POSTGRESQL_STORAGE_SIZE=10Gi
POSTGRESQL_MEMORY_REQUEST=1Gi
POSTGRESQL_MEMORY_LIMIT=1Gi
POSTGRESQL_CPU_REQUEST=1000m
POSTGRESQL_CPU_LIMIT=1000m
POSTGRESQL_MAX_CONNECTIONS=100
POSTGRESQL_SHARED_BUFFERS=128MB
POSTGRESQL_EFFECTIVE_CACHE_SIZE=512MB
POSTGRESQL_BACKUP_RETENTION=7

# --- MONITORING STACK (Dev Optimizations) ---

# Loki - Reduced resources and retention
LOKI_REPLICA_COUNT=1
LOKI_MEMORY_REQUEST=512Mi
LOKI_MEMORY_LIMIT=512Mi
LOKI_CPU_REQUEST=250m
LOKI_CPU_LIMIT=250m
LOKI_STORAGE_SIZE=5Gi
LOKI_RETENTION_PERIOD=168h  # 7 days
LOKI_REDIS_POOL_SIZE=5
LOKI_WRITE_POOL_SIZE=3

# Prometheus Stack - Development resources
PROMETHEUS_MEMORY_REQUEST=1Gi
PROMETHEUS_MEMORY_LIMIT=1Gi
PROMETHEUS_CPU_REQUEST=1000m
PROMETHEUS_CPU_LIMIT=1000m
PROMETHEUS_STORAGE_SIZE=20Gi
PROMETHEUS_RETENTION_SIZE=5GiB
PROMETHEUS_RETENTION_TIME=7d
GRAFANA_MEMORY_REQUEST=256Mi
GRAFANA_MEMORY_LIMIT=256Mi
GRAFANA_CPU_REQUEST=250m
GRAFANA_CPU_LIMIT=250m
ALERTMANAGER_MEMORY_REQUEST=128Mi
ALERTMANAGER_MEMORY_LIMIT=128Mi

# Promtail - Minimal resources
PROMTAIL_MEMORY_REQUEST=128Mi
PROMTAIL_MEMORY_LIMIT=128Mi
PROMTAIL_CPU_REQUEST=100m
PROMTAIL_CPU_LIMIT=100m

# Metrics Server - Minimal resources
METRICS_SERVER_MEMORY_REQUEST=64Mi
METRICS_SERVER_MEMORY_LIMIT=64Mi
METRICS_SERVER_CPU_REQUEST=100m
METRICS_SERVER_CPU_LIMIT=100m

# --- APPLICATION SERVICES (Dev Optimizations) ---

# N8N - Single instance, reduced resources
N8N_MEMORY_REQUEST=512Mi
N8N_MEMORY_LIMIT=512Mi
N8N_CPU_REQUEST=500m
N8N_CPU_LIMIT=500m
N8N_STORAGE_SIZE=2Gi
N8N_REPLICA_COUNT=1

# Temporal - Reduced resources for development
TEMPORAL_SERVER_MEMORY_REQUEST=1Gi
TEMPORAL_SERVER_MEMORY_LIMIT=1Gi
TEMPORAL_SERVER_CPU_REQUEST=1000m
TEMPORAL_SERVER_CPU_LIMIT=1000m
TEMPORAL_WEB_MEMORY_REQUEST=256Mi
TEMPORAL_WEB_MEMORY_LIMIT=256Mi
TEMPORAL_WEB_CPU_REQUEST=250m
TEMPORAL_WEB_CPU_LIMIT=250m
TEMPORAL_STORAGE_SIZE=5Gi

# Ollama (Dev: reduced memory, same model)
OLLAMA_MEMORY_REQUEST=2Gi
OLLAMA_MEMORY_LIMIT=3Gi
OLLAMA_CPU_REQUEST=500m
OLLAMA_CPU_LIMIT=1000m
OLLAMA_STORAGE_SIZE=5Gi
# Dev override: use native macOS Ollama (M4 Neural Engine) instead of in-cluster CPU-only.
# host.docker.internal resolves to 192.168.5.2 (macOS host) from inside Kind pods on Colima.
# Requires Ollama to be running natively with: OLLAMA_HOST=0.0.0.0 ollama serve
OLLAMA_HOST=http://host.docker.internal:11434

# kagent (Dev: reduced resources)
KAGENT_CONTROLLER_MEMORY_REQUEST=128Mi
KAGENT_CONTROLLER_MEMORY_LIMIT=256Mi
KAGENT_CONTROLLER_CPU_REQUEST=100m
KAGENT_CONTROLLER_CPU_LIMIT=500m
KAGENT_UI_MEMORY_REQUEST=256Mi
KAGENT_UI_MEMORY_LIMIT=512Mi
KAGENT_UI_CPU_REQUEST=100m
KAGENT_UI_CPU_LIMIT=250m
KAGENT_AGENT_MEMORY_REQUEST=256Mi
KAGENT_AGENT_MEMORY_LIMIT=512Mi
KAGENT_AGENT_CPU_REQUEST=100m
KAGENT_AGENT_CPU_LIMIT=500m

# --- DATABASE UI TOOLS (Dev Optimizations) ---

# pgAdmin4 - Minimal resources
PGADMIN4_MEMORY_REQUEST=256Mi
PGADMIN4_MEMORY_LIMIT=256Mi
PGADMIN4_CPU_REQUEST=200m
PGADMIN4_CPU_LIMIT=200m
PGADMIN4_STORAGE_SIZE=1Gi

# RedisInsight - Minimal resources
REDISINSIGHT_MEMORY_REQUEST=128Mi
REDISINSIGHT_MEMORY_LIMIT=128Mi
REDISINSIGHT_CPU_REQUEST=100m
REDISINSIGHT_CPU_LIMIT=100m
REDISINSIGHT_STORAGE_SIZE=500Mi

# --- GITOPS AND MANAGEMENT (Dev Optimizations) ---

# Weave GitOps - Minimal resources
WEAVE_GITOPS_MEMORY_REQUEST=128Mi
WEAVE_GITOPS_MEMORY_LIMIT=128Mi
WEAVE_GITOPS_CPU_REQUEST=100m
WEAVE_GITOPS_CPU_LIMIT=100m

# --- CROSSPLANE (Dev Optimizations) ---

# Crossplane - Reduced resources for development
CROSSPLANE_MEMORY_REQUEST=256Mi
CROSSPLANE_MEMORY_LIMIT=256Mi
CROSSPLANE_CPU_REQUEST=250m
CROSSPLANE_CPU_LIMIT=250m

# --- DEV ENVIRONMENT DEFAULTS ---

# Default resource requests and limits (guaranteed QoS)
DEFAULT_MEMORY_REQUEST=128Mi
DEFAULT_MEMORY_LIMIT=128Mi
DEFAULT_CPU_REQUEST=100m
DEFAULT_CPU_LIMIT=100m

# Storage optimization
DEFAULT_STORAGE_CLASS=standard
DEFAULT_STORAGE_SIZE=2Gi

# Network timeouts (shorter for faster development cycles)
DEFAULT_CONNECTION_TIMEOUT=15s
DEFAULT_READ_TIMEOUT=30s
DEFAULT_WRITE_TIMEOUT=30s
