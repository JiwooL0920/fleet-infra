# ========================================
# PRODUCTION ENVIRONMENT OVERRIDES
# ========================================
# Performance-optimized configuration for production environment
# Higher resource allocations, multiple replicas, extended retention periods

# Environment identification
CLUSTER_NAME=services-amer-prod
ENVIRONMENT=production

# --- INFRASTRUCTURE CORE (Prod Optimizations) ---

# Traefik - High availability with multiple instances
TRAEFIK_MEMORY_REQUEST=256Mi
TRAEFIK_MEMORY_LIMIT=1Gi
TRAEFIK_CPU_REQUEST=200m
TRAEFIK_CPU_LIMIT=2000m
TRAEFIK_REPLICA_COUNT=2

# LocalStack - Not typically used in production, but maintained for consistency
LOCALSTACK_MEMORY_REQUEST=1Gi
LOCALSTACK_MEMORY_LIMIT=2Gi
LOCALSTACK_CPU_REQUEST=500m
LOCALSTACK_CPU_LIMIT=2000m
LOCALSTACK_STORAGE_SIZE=10Gi

# --- OPERATORS (Prod Optimizations) ---

# CNPG Operator - Production-grade resources
CNPG_OPERATOR_MEMORY_REQUEST=256Mi
CNPG_OPERATOR_MEMORY_LIMIT=512Mi
CNPG_OPERATOR_CPU_REQUEST=200m
CNPG_OPERATOR_CPU_LIMIT=1000m

# External Secrets - Production resources with high availability
EXTERNAL_SECRETS_MEMORY_REQUEST=256Mi
EXTERNAL_SECRETS_MEMORY_LIMIT=512Mi
EXTERNAL_SECRETS_CPU_REQUEST=100m
EXTERNAL_SECRETS_CPU_LIMIT=500m
EXTERNAL_SECRETS_WEBHOOK_REPLICA_COUNT=2

# --- DATABASE SERVICES (Prod Optimizations) ---

# Redis - High availability with multiple replicas
REDIS_REPLICA_COUNT=2
REDIS_MASTER_MEMORY_REQUEST=512Mi
REDIS_MASTER_MEMORY_LIMIT=1Gi
REDIS_MASTER_CPU_REQUEST=200m
REDIS_MASTER_CPU_LIMIT=1000m
REDIS_REPLICA_MEMORY_REQUEST=512Mi
REDIS_REPLICA_MEMORY_LIMIT=1Gi
REDIS_REPLICA_CPU_REQUEST=200m
REDIS_REPLICA_CPU_LIMIT=1000m
REDIS_STORAGE_SIZE=16Gi
REDIS_MAXMEMORY=900mb
REDIS_SENTINEL_DOWN_AFTER_MILLISECONDS=30000
REDIS_SENTINEL_FAILOVER_TIMEOUT=180000
REDIS_SENTINEL_PARALLEL_SYNCS=1
REDIS_SENTINEL_MEM_REQ=128Mi
REDIS_SENTINEL_MEM_LIM=256Mi
REDIS_SENTINEL_CPU_REQ=100m
REDIS_SENTINEL_CPU_LIM=500m
REDIS_METRICS_ENABLED=true

# PostgreSQL - High availability cluster
POSTGRESQL_INSTANCES=3
POSTGRESQL_STORAGE_SIZE=100Gi
POSTGRESQL_MEMORY_REQUEST=2Gi
POSTGRESQL_MEMORY_LIMIT=4Gi
POSTGRESQL_CPU_REQUEST=1000m
POSTGRESQL_CPU_LIMIT=4000m
POSTGRESQL_MAX_CONNECTIONS=500
POSTGRESQL_SHARED_BUFFERS=1GB
POSTGRESQL_EFFECTIVE_CACHE_SIZE=3GB
POSTGRESQL_BACKUP_RETENTION=30

# --- MONITORING STACK (Prod Optimizations) ---

# Loki - Production performance and retention
LOKI_REPLICA_COUNT=2
LOKI_MEMORY_REQUEST=1Gi
LOKI_MEMORY_LIMIT=2Gi
LOKI_CPU_REQUEST=500m
LOKI_CPU_LIMIT=2000m
LOKI_STORAGE_SIZE=50Gi
LOKI_RETENTION_PERIOD=720h  # 30 days
LOKI_REDIS_POOL_SIZE=20
LOKI_WRITE_POOL_SIZE=10

# Prometheus Stack - Production performance
PROMETHEUS_MEMORY_REQUEST=2Gi
PROMETHEUS_MEMORY_LIMIT=4Gi
PROMETHEUS_CPU_REQUEST=1000m
PROMETHEUS_CPU_LIMIT=4000m
PROMETHEUS_STORAGE_SIZE=100Gi
PROMETHEUS_RETENTION_SIZE=20GiB
PROMETHEUS_RETENTION_TIME=30d
GRAFANA_MEMORY_REQUEST=512Mi
GRAFANA_MEMORY_LIMIT=1Gi
GRAFANA_CPU_REQUEST=200m
GRAFANA_CPU_LIMIT=1000m
ALERTMANAGER_MEMORY_REQUEST=256Mi
ALERTMANAGER_MEMORY_LIMIT=512Mi

# Promtail - Production resources
PROMTAIL_MEMORY_REQUEST=256Mi
PROMTAIL_MEMORY_LIMIT=512Mi
PROMTAIL_CPU_REQUEST=100m
PROMTAIL_CPU_LIMIT=500m

# Metrics Server - Production resources
METRICS_SERVER_MEMORY_REQUEST=128Mi
METRICS_SERVER_MEMORY_LIMIT=256Mi
METRICS_SERVER_CPU_REQUEST=100m
METRICS_SERVER_CPU_LIMIT=500m

# --- APPLICATION SERVICES (Prod Optimizations) ---

# N8N - Production high availability
N8N_MEMORY_REQUEST=1Gi
N8N_MEMORY_LIMIT=2Gi
N8N_CPU_REQUEST=500m
N8N_CPU_LIMIT=2000m
N8N_STORAGE_SIZE=10Gi
N8N_REPLICA_COUNT=2

# Temporal - Production performance
TEMPORAL_SERVER_MEMORY_REQUEST=2Gi
TEMPORAL_SERVER_MEMORY_LIMIT=4Gi
TEMPORAL_SERVER_CPU_REQUEST=1000m
TEMPORAL_SERVER_CPU_LIMIT=4000m
TEMPORAL_WEB_MEMORY_REQUEST=512Mi
TEMPORAL_WEB_MEMORY_LIMIT=1Gi
TEMPORAL_WEB_CPU_REQUEST=200m
TEMPORAL_WEB_CPU_LIMIT=1000m
TEMPORAL_STORAGE_SIZE=20Gi

# --- DATABASE UI TOOLS (Prod Optimizations) ---

# pgAdmin4 - Production resources
PGADMIN4_MEMORY_REQUEST=512Mi
PGADMIN4_MEMORY_LIMIT=1Gi
PGADMIN4_CPU_REQUEST=200m
PGADMIN4_CPU_LIMIT=1000m
PGADMIN4_STORAGE_SIZE=5Gi

# RedisInsight - Production resources
REDISINSIGHT_MEMORY_REQUEST=256Mi
REDISINSIGHT_MEMORY_LIMIT=512Mi
REDISINSIGHT_CPU_REQUEST=100m
REDISINSIGHT_CPU_LIMIT=500m
REDISINSIGHT_STORAGE_SIZE=2Gi

# --- GITOPS AND MANAGEMENT (Prod Optimizations) ---

# Weave GitOps - Production resources
WEAVE_GITOPS_MEMORY_REQUEST=256Mi
WEAVE_GITOPS_MEMORY_LIMIT=512Mi
WEAVE_GITOPS_CPU_REQUEST=100m
WEAVE_GITOPS_CPU_LIMIT=500m

# --- CROSSPLANE (Prod Optimizations) ---

# Crossplane - Production resources
CROSSPLANE_MEMORY_REQUEST=512Mi
CROSSPLANE_MEMORY_LIMIT=1Gi
CROSSPLANE_CPU_REQUEST=200m
CROSSPLANE_CPU_LIMIT=1000m

# --- PRODUCTION ENVIRONMENT DEFAULTS ---

# Default resource requests and limits (production-grade)
DEFAULT_MEMORY_REQUEST=256Mi
DEFAULT_MEMORY_LIMIT=512Mi
DEFAULT_CPU_REQUEST=100m
DEFAULT_CPU_LIMIT=500m

# Storage optimization for production
DEFAULT_STORAGE_CLASS=standard
DEFAULT_STORAGE_SIZE=10Gi

# Network timeouts (optimized for production stability)
DEFAULT_CONNECTION_TIMEOUT=60s
DEFAULT_READ_TIMEOUT=120s
DEFAULT_WRITE_TIMEOUT=120s